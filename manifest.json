{
	"manifest_version": 3,
	"name": "Extension Manager Pro",
	"version": "1.0",
	"description": "Manage and control your Chrome extensions",
	"permissions": [
		"management",
		"storage",
		"tabs",
		"webNavigation",
		"activeTab"
	],
	"host_permissions": [
		"*://example.com/*",
		"edge://*/*",
		"chrome://*/*",
		"*://*.google.com/*",
		"https://chrome.google.com/webstore/*",
		"https://chromewebstore.google.com/*"
	],
	"content_scripts": [
		{
			"matches": [
				"*://example.com/extensions",
				"*://example.com/extensions/hidden",
				"https://chrome.google.com/webstore/*",
				"https://chromewebstore.google.com/*"
			],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"background": {
		"service_worker": "background.js"
	}
}
